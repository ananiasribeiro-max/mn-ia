# ============================================================
#  MN-IA — copie para .env e preencha. NUNCA versione o .env.
# ============================================================

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
MNIA_MODELO_CLASSIFICACAO=claude-haiku-5-5
MNIA_MODELO_REDACAO=claude-sonnet-5-5
MNIA_MODELO_ANALISE=claude-opus-5-5

# --- Banco ---
# Produção (docker-compose já cria este banco):
MNIA_DATABASE_URL=postgresql+psycopg://mnia:TROQUE_ESTA_SENHA@db:5432/mnia
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# IDs dos grupos (números negativos, ex.: -1001234567890)
TELEGRAM_CHAT_RADAR=
TELEGRAM_CHAT_CLIPPING=
TELEGRAM_CHAT_TRIAGEM=
TELEGRAM_CHAT_TECNICO=

# --- E-mail de pauta (triagem) ---
IMAP_HOST=
IMAP_USUARIO=
IMAP_SENHA=
IMAP_PASTA=INBOX

# --- Comportamento ---
MNIA_SIMULADO=0
MNIA_FUSO=America/Fortaleza
MNIA_RADAR_INTERVALO_MIN=5
MNIA_RADAR_RESUMO_HORARIO=1
MNIA_CLIPPING_HORARIO=05:30
MNIA_TRIAGEM_INTERVALO_MIN=10
MNIA_RELEVANCIA_MINIMA=6
MNIA_MAX_ITENS_RODADA=60
