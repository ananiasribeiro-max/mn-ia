# ============================================================
#  MN-IA — copie para .env e preencha. NUNCA versione o .env.
# ============================================================

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
MNIA_MODELO_CLASSIFICACAO=claude-haiku-5-5
MNIA_MODELO_REDACAO=claude-sonnet-5-5
MNIA_MODELO_ANALISE=claude-opus-5-5

# --- Banco ---
# Produção (docker-compose já cria este banco):
MNIA_DATABASE_URL=postgresql+psycopg://mnia:TROQUE_ESTA_SENHA@db:5432/mnia
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# IDs dos grupos (números negativos, ex.: -1001234567890)
TELEGRAM_CHAT_RADAR=
TELEGRAM_CHAT_CLIPPING=
TELEGRAM_CHAT_TRIAGEM=
TELEGRAM_CHAT_TECNICO=
# Opcionais: sem eles, laudas e material digital vão para o grupo do Radar
TELEGRAM_CHAT_PRODUCAO=
TELEGRAM_CHAT_DIGITAL=

# --- E-mail de pauta (triagem) ---
IMAP_HOST=
IMAP_USUARIO=
IMAP_SENHA=
IMAP_PASTA=INBOX

# --- Comportamento ---
MNIA_SIMULADO=0
MNIA_FUSO=America/Fortaleza
MNIA_RADAR_INTERVALO_MIN=5
MNIA_RADAR_RESUMO_HORARIO=1
MNIA_CLIPPING_HORARIO=05:30
MNIA_TRIAGEM_INTERVALO_MIN=10
MNIA_RELEVANCIA_MINIMA=6
MNIA_MAX_ITENS_RODADA=60

# --- YouTube / vídeo ---
MNIA_YOUTUBE_CANAL=https://www.youtube.com/@meionortemais
MNIA_YOUTUBE_INTERVALO_MIN=15
MNIA_YOUTUBE_MAX_VIDEOS=3
MNIA_CORTES_POR_VIDEO=3
MNIA_CORTES_LIGADOS=1

# --- Laudas ---
MNIA_LAUDAS_POR_HORA=3
MNIA_LAUDA_RELEVANCIA_MINIMA=8

# --- Visual dos cortes (card | cheia | manchete) ---
MNIA_CORTE_MODELO=card
MNIA_CORTE_PROGRAMA=CENTRAL MEIO NORTE
MNIA_CORTE_PERFIL=@centralmeionorte
MNIA_CORTE_CHAMADA=DE SEGUNDA A SEXTA, 7H30
MNIA_CORTE_SITE=MEIONORTE.COM
# Logo: coloque um PNG com fundo transparente em dados/marca/logo.png
